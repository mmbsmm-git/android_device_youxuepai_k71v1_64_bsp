# YOUXUEPAI U60 / P709 (k71v1_64_bsp) — TWRP fstab 修复版
#
# 三处根因（对照原文件）：
#  1) 原 68 行全部写 /dev/block/platform/bootdevice/by-name/，但这台 MTK 在
#     recovery 里实际存在的是 /dev/block/by-name/
#     —— 证据：本仓库 init.recovery.mt6771.rc 第 48 行 mount cache 用的就是
#        /dev/block/by-name/cache；用户 root shell 的 dd 也是这个路径。
#     ueventd.rc 是高通通用模板（kgsl/msm_hw3d/oncrpc），没有 MTK 的 by-name
#     规则，只在 init.rc 里手工建了 preloader_a/b 两个 bootdevice 链接。
#     路径解析失败 -> 只有 TWRP 内建特殊处理的 boot/recovery 能出现在菜单。
#  2) 原条目第 5 列全是 defaults，缺 TWRP 的 display / backup=1 / flashimg=1
#     -> 即便路径对了，Mount / Backup / Install→Flash Image 也不会列这些分区。
#  3) data 带 encryptable=.../metadata，但 BoardConfig 是 TW_INCLUDE_CRYPTO := false
#     且本机 data 未加密 -> 去掉 encryptable，补 storage 让 /data/media 当内部存储。
#
# 格式：<src> <mount_point> <fstype> <mount_flags> <flags=...>
# A-only 无 slot，不需要 slotselect。

# ---------- 可挂载文件系统 ----------
/dev/block/by-name/system      /                        ext4  ro                                                        flags=display="System";backup=1
/dev/block/by-name/vendor      /vendor                  ext4  ro                                                        flags=display="Vendor";backup=1
/dev/block/by-name/userdata    /data                    ext4  noatime,nosuid,nodev,noauto_da_alloc,errors=panic       flags=display="Data";backup=1;wipeingui;storage
/dev/block/by-name/metadata    /metadata                ext4  noatime,nosuid,nodev                                     flags=backup=1;wipeingui
/dev/block/by-name/cache       /cache                   ext4  noatime,nosuid,nodev,noauto_da_alloc,discard             flags=display="Cache";backup=1;wipeingui

/dev/block/by-name/protect1    /mnt/vendor/protect_f    ext4  noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc  flags=backup=1
/dev/block/by-name/protect2    /mnt/vendor/protect_s    ext4  noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc  flags=backup=1
/dev/block/by-name/nvdata      /mnt/vendor/nvdata       ext4  noatime,nosuid,nodev,noauto_da_alloc,discard             flags=backup=1
/dev/block/by-name/nvcfg       /mnt/vendor/nvcfg        ext4  noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc  flags=backup=1
/dev/block/by-name/noah        /mnt/vendor/noah         ext4  noatime,nosuid,nodev,noauto_da_alloc,discard             flags=backup=1

# ---------- 可安全卡刷的裸分区（Install → Flash Image 会出现）----------
/dev/block/by-name/boot        /boot                     emmc  defaults  flags=display="Boot";backup=1;flashimg=1;wipeingui
/dev/block/by-name/recovery    /recovery                 emmc  defaults  flags=display="Recovery";backup=1;flashimg=1;wipeingui
/dev/block/by-name/dtbo        /dtbo                     emmc  defaults  flags=display="Dtbo";backup=1;flashimg=1
/dev/block/by-name/lk          /bootloader               emmc  defaults  flags=display="LK";backup=1;flashimg=1
/dev/block/by-name/lk2         /bootloader2              emmc  defaults  flags=display="LK2";backup=1;flashimg=1
/dev/block/by-name/logo        /logo                     emmc  defaults  flags=display="Logo";backup=1;flashimg=1
/dev/block/by-name/tee1        /tee1                     emmc  defaults  flags=display="TEE1";backup=1;flashimg=1
/dev/block/by-name/tee2        /tee2                     emmc  defaults  flags=display="TEE2";backup=1;flashimg=1
/dev/block/by-name/gz1         /gz1                      emmc  defaults  flags=display="GZ1";backup=1;flashimg=1
/dev/block/by-name/gz2         /gz2                      emmc  defaults  flags=display="GZ2";backup=1;flashimg=1
/dev/block/by-name/scp1        /scp1                     emmc  defaults  flags=display="SCP1";backup=1;flashimg=1
/dev/block/by-name/scp2        /scp2                     emmc  defaults  flags=display="SCP2";backup=1;flashimg=1
/dev/block/by-name/sspm_1      /sspm_1                   emmc  defaults  flags=display="SSPM1";backup=1;flashimg=1
/dev/block/by-name/sspm_2      /sspm_2                   emmc  defaults  flags=display="SSPM2";backup=1;flashimg=1
/dev/block/by-name/md1img      /md1img                   emmc  defaults  flags=display="Modem";backup=1;flashimg=1
/dev/block/by-name/md1dsp      /md1dsp                   emmc  defaults  flags=display="ModemDSP";backup=1;flashimg=1
/dev/block/by-name/cam_vpu1    /cam_vpu1                 emmc  defaults  flags=display="CamVPU1";backup=1;flashimg=1
/dev/block/by-name/cam_vpu2    /cam_vpu2                 emmc  defaults  flags=display="CamVPU2";backup=1;flashimg=1
/dev/block/by-name/cam_vpu3    /cam_vpu3                 emmc  defaults  flags=display="CamVPU3";backup=1;flashimg=1
/dev/block/by-name/spmfw       /spmfw                    emmc  defaults  flags=display="SPMFW";backup=1;flashimg=1
/dev/block/by-name/expdb       /expdb                    emmc  defaults  flags=display="EXPDB";backup=1;flashimg=1
/dev/block/by-name/boot_para   /boot_para                emmc  defaults  flags=display="BootPara";backup=1;flashimg=1
/dev/block/by-name/para        /misc                     emmc  defaults  flags=display="Para";backup=1;flashimg=1
/dev/block/by-name/proinfo     /proinfo                  emmc  defaults  flags=display="ProInfo";backup=1;flashimg=1
/dev/block/by-name/nvram       /nvram                    emmc  defaults  flags=display="NVRAM";backup=1;flashimg=1
/dev/block/by-name/otp         /otp                      emmc  defaults  flags=display="OTP";backup=1;flashimg=1
/dev/block/by-name/flashinfo   /flashinfo                emmc  defaults  flags=display="FlashInfo";backup=1;flashimg=1

# ---------- 只备份、不给 Flash Image（误刷会丢校准/密钥，别手滑）----------
/dev/block/by-name/frp         /persistent               emmc  defaults  flags=backup=1
/dev/block/by-name/seccfg      /seccfg                   emmc  defaults  flags=backup=1
/dev/block/by-name/sec1        /sec1                     emmc  defaults  flags=backup=1

# ---------- 外置存储（按需启用）----------
# 原文件这两行格式是错的：第二列写成 auto 当挂载点、还带 encryptable=userdata，
# 和「data 未加密」冲突。BOARD_HAS_NO_REAL_SDCARD := true 时整段可以不启用。
# 真要挂 SD/OTG，先 `ls /dev/block/mmcblk*` 确认编号，再放开下面两行：
# /dev/block/mmcblk1p1  /external_sd  vfat  defaults  flags=display="MicroSD";storage;wipeingui;removable
# /dev/block/sda1       /usb_otg      vfat  defaults  flags=display="USB-OTG";storage;wipeingui;removable
