# Normalize line endings on checkout
* text=auto

# These MUST stay LF. CRLF breaks shell/rc parsing on the Linux build runner.
*.mk      text eol=lf
*.sh      text eol=lf
*.rc      text eol=lf
*.fstab   text eol=lf
*.bp      text eol=lf
README.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
# 行尾强制 LF（Linux 构建/解析），二进制绝不转换
*.xml text eol=lf
*.py  text eol=lf
*.json text eol=lf
*.ttf binary
*.img binary
*.bin binary
kernel/kernel binary
